{
  "compilerOptions": {
    "target": "ES2020",  // Update this to ES2020 or later
    "module": "CommonJS",
    "paths": {
      "@db/*": ["../../db/src/*"]
    },
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true, 
    // "emitDeclarationOnly": true,  
    // "strict": true,
    "esModuleInterop": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
