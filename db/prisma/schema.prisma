// prisma/schema.prisma
datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

////////////////////////  Users  ////////////////////////

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  hashedPassword String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  usdcBalance BigInt @default(1000000000000)
  usdcLocked  BigInt @default(0)
  btcBalance  BigInt @default(5000000000)
  btcLocked   BigInt @default(0)

  orders Order[]
  trades Trade[] @relation("UserTrades")
}

////////////////////////  Orders  ///////////////////////

model Order {
  id        String      @id @default(uuid())
  eventId   String      @unique                    // <‑‑ added
  userId    String
  market    String
  side      OrderSide
  price     BigInt
  quantity  BigInt
  filled    BigInt      @default(0)
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  trades Trade[] @relation("OrderTrades")
}

enum OrderSide {
  buy
  sell
}

enum OrderStatus {
  PENDING
  PARTIALLY_FILLED
  FILLED
  CANCELLED
}

////////////////////////  Trades  ///////////////////////

model Trade {
  id            String   @id @default(uuid())
  eventId       String   @unique                 // <‑‑ added
  tradeId       Int      @unique
  market        String
  price         BigInt
  quantity      BigInt
  quoteQuantity BigInt
  isBuyerMaker  Boolean
  timestamp     DateTime

  makerOrderId  String?
  takerOrderId  String?
  makerUserId   String?
  takerUserId   String?

  order   Order? @relation("OrderTrades", fields: [orderId], references: [id])
  orderId String?

  user   User?  @relation("UserTrades", fields: [userId], references: [id])
  userId String?
}

////////////////////  Market data  //////////////////////

model Ticker {
  id        String   @id @default(uuid())
  market    String   @unique
  last      BigInt
  high      BigInt
  low       BigInt
  volume    BigInt
  updatedAt DateTime @default(now())
}

model Kline {
  id         String   @id @default(uuid())
  market     String
  interval   String   // "1m", "5m", …
  open       BigInt
  high       BigInt
  low        BigInt
  close      BigInt
  volume     BigInt
  trades     Int
  startTime  DateTime
  endTime    DateTime
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([market, interval, startTime])
}

model OrderbookSnapshot {
  id        String   @id @default(uuid())
  eventId   String   @unique                 // <‑‑ added
  market    String
  streamId  String
  snapshot  Json
  createdAt DateTime @default(now())

  @@index([market, createdAt])
}

model AggregatorState {
  id        String   @id @default(uuid())
  market    String
  interval  String
  lastTime  DateTime
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([market, interval])
}

////////////////////  Reconciliation  ////////////////////

model BalanceMismatch {
  id            String   @id @default(uuid())
  eventId       String   @unique                 // handy for replays
  userId        String
  asset         String   @db.VarChar(12)
  ledgerAvail   BigInt
  walletAvail   BigInt
  diffAvail     BigInt
  ledgerLocked  BigInt
  walletLocked  BigInt
  diffLocked    BigInt
  createdAt     DateTime @default(now())

  @@index([userId, asset])
}

////////////////////  House‑keeping  ////////////////////

model ProcessedEvent {
  id        String   @id
  createdAt DateTime @default(now())
}

model EngineProcessedEvent {
  id        String   @id
  createdAt DateTime @default(now())
}
